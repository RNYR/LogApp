# =============================================================================
# Sklad — TEST stack configuration (copy to .env.test; never commit .env.test)
#
# Used only by docker-compose.test.yml via ./scripts/test-stack. The live
# stack's .env is not read by the test app. Values here are the app's settings
# (docs/contracts/config.md) plus the SKLAD_TEST_* keys the wrapper uses for
# host names and ports.
# =============================================================================

# --- Test address & ports (read by scripts/test-stack) ------------------------
SKLAD_TEST_HOST=sklad-test.local
SKLAD_TEST_HOST_ALT=sklad-test
# The NAS LAN address, so https://<nas-ip>:8444 also gets a valid certificate.
SKLAD_TEST_LAN_IP=
# Must not clash with the live stack (80/443, or 8080/8443 on QNAP).
SKLAD_TEST_HTTP_PORT=8081
SKLAD_TEST_HTTPS_PORT=8444

# --- App -----------------------------------------------------------------------
SKLAD_LOG_LEVEL=debug
SKLAD_LOG_FORMAT=json
SKLAD_TZ=Europe/Prague
# Consistent SQLite copy at startup and every interval (minimum 1m).
SKLAD_BACKUP_INTERVAL=24h

# First-boot Admin for the (empty) test database. Editors need no login
# (anonymous rental mode), so this is the only account. Use a different password from
# production; you are asked to change it on first login.
SKLAD_ADMIN_USERNAME=admin
SKLAD_ADMIN_PASSWORD=
SKLAD_ADMIN_EMAIL=

# Distinct cookie names: if you open both stacks by IP (https://<nas-ip> and
# https://<nas-ip>:8444) the browser shares cookies across ports, so equal names
# would make the two logins overwrite each other.
SKLAD_SESSION_COOKIE_NAME=sklad_test_session
SKLAD_CSRF_COOKIE_NAME=sklad_test_csrf
SKLAD_SESSION_TTL=24h

# Reserved, unused (see docs/contracts/config.md).
SKLAD_COOKIE_SECRET=
SKLAD_ALLOWED_ORIGINS=
