# =============================================================================
# Sklad — environment configuration (example)
#
# Copy this file to `.env` and adjust. `.env` is gitignored — NEVER commit real
# secrets. Every key below is documented in docs/contracts/config.md, which is
# the frozen source of truth. All keys are optional unless marked REQUIRED.
#
# Runtime settings such as the Discord webhook URL and the daily check hour are
# NOT set here; they live in the database and are edited in the admin UI
# (GET/PUT /api/v1/settings). See docs/contracts/config.md.
# =============================================================================

# --- HTTP server (internal) --------------------------------------------------
# Internal listen address of the Go app. Caddy terminates TLS and proxies to it;
# this port is not published to the host.
SKLAD_HTTP_ADDR=:8080

# --- Persistence -------------------------------------------------------------
# Root of the persisted volume: SQLite DB, backups, and generated CA/certs.
SKLAD_DATA_DIR=/data
# SQLite backup at startup and every interval; minimum 1m, default 24h.
SKLAD_BACKUP_INTERVAL=24h
# SQLite file path. Defaults to ${SKLAD_DATA_DIR}/sklad.db.
# SKLAD_DB_PATH=/data/sklad.db

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error
SKLAD_LOG_LEVEL=info
# json | text
SKLAD_LOG_FORMAT=json

# --- First-boot admin seed ---------------------------------------------------
# Used only to create the initial admin account, which is forced to change its
# password on first login. SKLAD_ADMIN_PASSWORD is REQUIRED at boot.
SKLAD_ADMIN_USERNAME=admin
SKLAD_ADMIN_PASSWORD=change-me-on-first-login
# Optional seed admin email.
SKLAD_ADMIN_EMAIL=

# --- Sessions, cookies & auth ------------------------------------------------
# Reserved compatibility setting; current random server-side session tokens do not use it.
SKLAD_COOKIE_SECRET=
SKLAD_SESSION_TTL=24h
SKLAD_SESSION_COOKIE_NAME=sklad_session
SKLAD_CSRF_COOKIE_NAME=sklad_csrf

# --- Public origin, locale & proxy -------------------------------------------
# Public origin used to build links and labels.
SKLAD_BASE_URL=https://sklad.local
# IANA timezone used by the scheduler and date rendering.
SKLAD_TZ=Europe/Prague
# Comma-separated CORS origins; empty means same-origin only.
SKLAD_ALLOWED_ORIGINS=
# Honor X-Forwarded-For / X-Real-IP (Caddy is the reverse proxy).
SKLAD_TRUST_PROXY=true

# =============================================================================
# Docker Compose deployment (read by docker compose, not by the app itself)
#
# `docker compose` uses this file for three things: the application variables
# above are handed to the app container, the edge variables below are handed to
# Caddy, and the port variables configure the host port publishing.
# See docs/DEPLOY-QNAP.md for the NAS walkthrough.
# =============================================================================

# --- Host ports (published by the Caddy container) ---------------------------
# QTS web admin commonly occupies 80/443. If it does, use 8080/8443 here AND set
# SKLAD_PUBLIC_PORT=:8443 below, then browse to https://sklad.local:8443.
SKLAD_HTTP_PORT=80
SKLAD_HTTPS_PORT=443

# --- Names and addresses the edge serves (Caddy) -----------------------------
# These become the certificate's SANs, so keep them accurate.
SKLAD_HOST=sklad.local
SKLAD_HOST_ALT=sklad
# The NAS LAN address. Set it: without it, https://<nas-ip> shows a certificate
# warning and the browser camera stays blocked on that address.
SKLAD_LAN_IP=
# Suffix appended to the HTTP->HTTPS redirect when HTTPS is not on 443, for
# example ":8443". Must match SKLAD_HTTPS_PORT.
SKLAD_PUBLIC_PORT=

# --- Edge behaviour ----------------------------------------------------------
# Caddy log level: DEBUG | INFO | WARN | ERROR. The app's own level is
# SKLAD_LOG_LEVEL above (lower case), which is why this is a separate key.
SKLAD_CADDY_LOG_LEVEL=INFO
# HSTS max-age in seconds; use 0 while the CA still has to be installed on
# devices, so a mistake is easy to undo.
SKLAD_HSTS_MAX_AGE=31536000
# Request body cap enforced at the edge.
SKLAD_MAX_UPLOAD=10MB
# Which edge configuration to mount:
#   deploy/Caddyfile      Caddy's internal CA (default, zero configuration)
#   deploy/Caddyfile.byo  your own certificates (see deploy/certs/README.md)
CADDYFILE=./deploy/Caddyfile

# --- Image build metadata (optional) -----------------------------------------
# Shown by GET /api/v1/version and on the About page.
# SKLAD_VERSION=2.0.0
# SKLAD_COMMIT=
# SKLAD_BUILD_TIME=

# --- Container user (optional) -----------------------------------------------
# Only needed when /data is a bind mount owned by another account, for example
# the NAS share owner. Changing it requires a rebuild.
# SKLAD_UID=10001
# SKLAD_GID=10001
