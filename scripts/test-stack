#!/usr/bin/env sh
# =============================================================================
# scripts/test-stack — run the Sklad TEST stack beside the live one
#
# Always uses project "sklad-test", docker-compose.test.yml and .env.test, so a
# command typed here can never touch the live sklad.local containers, image or
# volumes. Run it from the project folder (or anywhere: it cd's there itself).
#
#   ./scripts/test-stack up           build the sklad:test image and start
#   ./scripts/test-stack up-nobuild   start from an already loaded sklad:test
#   ./scripts/test-stack ps           container health
#   ./scripts/test-stack logs         follow test-app + test-caddy logs
#   ./scripts/test-stack restart      restart both test containers
#   ./scripts/test-stack down         stop and remove the test containers
#                                     (test data and test CA are kept)
#   ./scripts/test-stack reset        down + DELETE the test volumes
#                                     (empty database and a NEW test CA next time)
#   ./scripts/test-stack export [DIR] consistent copy of the TEST database in
#                                     DIR/<time>/sklad.db (default
#                                     <share>/Backup/sklad-test), e.g. to
#                                     replace the live data (docs/FRESH-START.md)
#   ./scripts/test-stack config       print the resolved compose config
#   ./scripts/test-stack compose ...  any other docker compose subcommand
#
# See docs/DEPLOY-TEST.md.
# =============================================================================
set -eu

cd "$(dirname "$0")/.."
HERE=$(pwd)

# Docker / Compose on QNAP Container Station. /share is a RAM disk rebuilt at
# boot, so a symlink such as /share/Container/bin does not survive a reboot:
# look in the Container Station package itself as well.
CS=/share/CACHEDEV1_DATA/.qpkg/container-station
PATH=$CS/bin:$CS/usr/bin:/share/Container/bin:$PATH
if ! command -v docker-compose >/dev/null 2>&1; then
	found=$(find "$CS" -maxdepth 6 -name docker-compose \( -type f -o -type l \) 2>/dev/null | head -n 1)
	[ -z "$found" ] || PATH=$(dirname "$found"):$PATH
fi
export PATH

PROJECT=sklad-test
FILE=docker-compose.test.yml
ENVFILE=.env.test

die() { echo "test-stack: $*" >&2; exit 1; }

# on_ram_disk DIR — true when DIR (or its nearest existing parent) is on tmpfs.
on_ram_disk() {
	d=$1
	while [ ! -d "$d" ] && [ "$d" != / ]; do d=$(dirname "$d"); done
	[ "$(df -P "$d" 2>/dev/null | awk 'NR == 2 { print $1 }')" = tmpfs ]
}
on_ram_disk "$HERE" && echo "test-stack: WARNING: $HERE is on the RAM disk and is lost at the next reboot" >&2

# export [DIR] — consistent snapshot of the TEST database, taken by the server
# binary inside the running container (VACUUM INTO), copied out of the volume.
export_db() {
	root=${1:-$(dirname "$(dirname "$HERE")")/Backup/sklad-test}
	on_ram_disk "$root" && die "$root is on the RAM disk (lost at reboot); use a folder under /share/CACHEDEV1_DATA/<share>/"
	[ "$(docker inspect -f '{{.State.Running}}' sklad-test-app 2>/dev/null || true)" = true ] ||
		die "sklad-test-app is not running (./scripts/test-stack up)"
	out="$root/$(date -u +%Y%m%dT%H%M%SZ)"
	mkdir -p "$out"
	chmod 700 "$root" "$out"
	path=$(docker exec sklad-test-app /usr/local/bin/sklad backup) || die "database snapshot failed"
	docker cp "sklad-test-app:$path" "$out/sklad.db" >/dev/null || die "copying $path out of sklad-test-app failed"
	chmod 600 "$out/sklad.db"
	user=$(sed -n 's/^SKLAD_ADMIN_USERNAME=//p' "$ENVFILE" | tail -n 1 | tr -d '"'"'"'\r')
	printf 'source=sklad-test\nadmin_username=%s\nexported_at=%s\n' "${user:-admin}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$out/INFO"
	chmod 600 "$out/INFO"
	echo "$out/sklad.db"
}

[ -f "$FILE" ] || die "$FILE not found (run from the Sklad project folder)"
[ -f "$ENVFILE" ] || die "$ENVFILE missing: cp .env.test.example $ENVFILE and fill it in"

# Export .env.test so the SKLAD_TEST_* keys reach compose's ${...} substitution.
# (Works with old docker-compose builds that lack --env-file.)
set -a
# shellcheck disable=SC1090
. "./$ENVFILE"
set +a

[ -n "${SKLAD_ADMIN_PASSWORD:-}" ] || die "set SKLAD_ADMIN_PASSWORD in $ENVFILE"

# Refuse ports the live stack uses.
live_ports="80 443"
if [ -f .env ]; then
	lp=$(sed -n 's/^SKLAD_HTTP_PORT=//p; s/^SKLAD_HTTPS_PORT=//p' .env | tr -d '"'"'"' \r')
	live_ports="$live_ports $lp"
fi
for p in ${SKLAD_TEST_HTTP_PORT:-8081} ${SKLAD_TEST_HTTPS_PORT:-8444}; do
	for q in $live_ports; do
		[ "$p" != "$q" ] || die "port $p is used by the live stack; pick another SKLAD_TEST_*_PORT in $ENVFILE"
	done
done

if docker compose version >/dev/null 2>&1; then
	compose() { docker compose -p "$PROJECT" -f "$FILE" "$@"; }
elif command -v docker-compose >/dev/null 2>&1; then
	compose() { docker-compose -p "$PROJECT" -f "$FILE" "$@"; }
else
	die "neither 'docker compose' nor 'docker-compose' is available"
fi

cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
	up)          compose up -d --build "$@" ;;
	up-nobuild)  compose up -d --no-build "$@" ;;
	ps)          compose ps "$@" ;;
	logs)        compose logs -f --tail=100 "$@" ;;
	restart)     compose restart "$@" ;;
	down)        compose down "$@" ;;
	reset)
		echo "This deletes the TEST database and the TEST CA (volumes sklad_test_*)."
		echo "The live sklad.local stack is not affected."
		printf 'Type "reset" to continue: '
		read -r answer
		[ "$answer" = "reset" ] || die "aborted"
		compose down -v "$@"
		;;
	export)      export_db "$@" ;;
	config)      compose config "$@" ;;
	compose)     compose "$@" ;;
	*)
		sed -n '4,25p' "$0" | sed 's/^# \{0,1\}//'
		[ -z "$cmd" ] || exit 1
		;;
esac
